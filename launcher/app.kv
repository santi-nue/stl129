#:kivy 2.3

BoxLayout:
    orientation: "vertical"
    padding: dp(10)
    spacing: dp(10)

    TextInput:
        id: code_input
        text: "# Paste Python code here\n\nprint('Hello!')\n\nfor i in range(3):\n    print(i)\n"
        font_size: "20sp"
        multiline: True
        size_hint_y: 0.45

    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: dp(60)
        spacing: dp(10)

        Button:
            text: "Run"
            bold: True
            font_size: "20sp"
            on_release: app.run_code()

        Button:
            text: "Clear output"
            font_size: "20sp"
            on_release: app.clear_output()


    TextInput:
        id: output_area
        text: "Ready."
        font_size: "20sp"
        multiline: True
        size_hint_y: 0.45
