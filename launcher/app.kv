#:kivy 2.3

BoxLayout:
    orientation: "vertical"
    padding: 10
    spacing: 10

    Label:
        text: "Python Code Runner"
        size_hint_y: None
        height: 35
        bold: True
        font_size: 22

    TextInput:
        id: code_input
        text: "# Paste Python code here\n\nprint('Hello!')\n\nfor i in range(3):\n    print(i)\n"
        font_size: 16
        multiline: True
        size_hint_y: 0.55

    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: 50
        spacing: 10

        Button:
            text: "Run"
            bold: True
            on_release: app.run_code()

        Button:
            text: "Clear output"
            on_release: app.clear_output()

    Label:
        text: "Output:"
        size_hint_y: None
        height: 25
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.width, self.height

    TextInput:
        id: output_area
        text: "Ready."
        readonly: True
        font_size: 14
        multiline: True
        size_hint_y: 0.45
