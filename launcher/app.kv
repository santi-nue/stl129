#:kivy 2.3

BoxLayout:
    orientation: "vertical"
    padding: 20
    spacing: 20

    Label:
        text: "Basic Kivy Test"
        font_size: 30

    Button:
        text: "Press me"
        on_release: app.say_hello()

    Label:
        id: output
        text: "Waiting..."
        font_size: 25
